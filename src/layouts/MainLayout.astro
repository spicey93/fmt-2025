---
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Aside from "../components/Aside.astro";
import TrustBar from "../components/TrustBar.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import CoverageAreas from "../components/CoverageAreas.astro";
import CtaBand from "../components/CtaBand.astro";

interface Props {
  title: string;
  description: string;
  heroHeading: string;
  heroSubheading: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  mainHeading: string;
  service?: { name: string; description: string };
}

const {
  title,
  description,
  heroHeading,
  heroSubheading,
  heroImage,
  heroImageAlt,
  mainHeading,
  service,
} = Astro.props;
---

<BaseLayout title={title} description={description} service={service} image={heroImage.src}>
  <Hero
    heroHeading={heroHeading}
    heroSubheading={heroSubheading}
    heroImage={heroImage}
    heroImageAlt={heroImageAlt}
  />
  <TrustBar />

  <section class="section">
    <div class="container content-grid">
      <article class="prose content-main">
        <p class="eyebrow">Freeway Mobile Tyres</p>
        <h2 class="main-heading">{mainHeading}</h2>
        <slot />
      </article>
      <Aside />
    </div>
  </section>

  <!-- Google Reviews -->
  <section class="section section--surface reviews">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Reviews</p>
        <h2>Trusted by drivers across Dorset</h2>
      </div>
      <div class="reviews-widget" data-elfsight-lazy>
        <div class="elfsight-app-fb7d1eca-cfda-467a-8de2-483ded2a6bdd"></div>
      </div>
    </div>
  </section>

  <HowItWorks />
  <ServiceGrid />
  <CoverageAreas />
  <CtaBand />
</BaseLayout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 992px) {
    .content-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }

  .main-heading {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-5);
  }

  .main-heading + :global(p) {
    font-size: var(--font-size-lg);
    color: var(--color-ink-800);
  }

  .reviews-widget {
    min-height: 240px;
  }
</style>
