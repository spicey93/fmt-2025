---
import BaseLayout from "../layouts/BaseLayout.astro";
import Heading from "../components/Heading.astro";
import Icon from "../components/Icon.astro";
import { navGroups } from "../data/nav";

const otherGroups = [
  {
    title: "Company",
    links: [
      { label: "Home", href: "/" },
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Legal Pages",
    links: [
      { label: "Cookie Policy", href: "/cookie-policy" },
      { label: "Terms & Conditions", href: "/terms-and-conditions" },
      { label: "Privacy Policy", href: "/privacy-policy" },
    ],
  },
];

const groups = [
  ...navGroups.map((group) => ({
    title: group.title,
    links: group.subPages.map((page) => ({ label: page.title, href: `/${group.slug}/${page.slug}` })),
  })),
  ...otherGroups,
];
---

<BaseLayout title="Site Map" description="Site map for Freeway Mobile Tyres">
  <Heading text="Site Map" eyebrow="Find your way" />
  <section class="section">
    <div class="container sitemap-grid">
      {
        groups.map((group) => (
          <div class="sitemap-group">
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>
                    {link.label}
                    <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-5);
  }

  .sitemap-group {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .sitemap-group h2 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-3);
  }

  .sitemap-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sitemap-group a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-ink-100);
    color: var(--color-ink-700);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .sitemap-group li:last-child a {
    border-bottom: 0;
  }

  .sitemap-group a:hover {
    color: var(--color-accent);
  }

  .sitemap-group :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--color-ink-300);
  }
</style>
