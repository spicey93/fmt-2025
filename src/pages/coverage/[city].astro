---
import MainLayout from "../../layouts/MainLayout.astro";
import { heroImages } from "../../data/images";

type Region = "north" | "conurbation" | "coastal";

interface CityProps {
  title: string;
  areas: string;
  about: string;
  region: Region;
  nearbyTowns: string[];
  localNote: string;
}

export async function getStaticPaths() {
  const cities: { params: { city: string }; props: CityProps }[] = [
    {
      params: { city: "blandford-forum" },
      props: {
        title: "Blandford Forum",
        areas: "Blandford Forum, Bryanston, Durweston, Langton Long Blandford, Shroton, Spetisbury, Tarrant Crawford, Tarrant Hinton",
        about: "Blandford Forum is a charming market town located in the northern part of Dorset. It is known for its Georgian architecture, with many of its buildings dating back to the 18th century. The town is also home to a bustling market, held on Thursdays and Saturdays, where visitors can find everything from fresh produce to handmade crafts. Blandford Forum is surrounded by beautiful countryside, with the River Stour running through the town, making it a popular destination for outdoor enthusiasts. Visitors can explore the nearby Cranborne Chase and West Wiltshire Downs Area of Outstanding Natural Beauty or take a leisurely stroll along the Stour Valley Way.",
        region: "north",
        nearbyTowns: ["Sturminster Newton", "Wimborne", "Shaftesbury"],
        localNote: "Blandford's weekly market and the farmland around it mean we're just as used to fitting tyres on horseboxes and 4x4s outside town as we are on the school run.",
      },
    },
    {
      params: { city: "bournemouth" },
      props: {
        title: "Bournemouth",
        areas: "Bournemouth, Bear Cross, Castlepoint, Charminster, East Cliff, East Howe, Ensbury, Kinson, Lansdowne, Muscliff, Northbourne, Redhill, Strouden Park, Talbot Park, West Cliff, West Howe, Westbourne",
        about: "Bournemouth is a popular coastal resort town located on the south coast of England. It is known for its long sandy beaches, Victorian architecture, and vibrant nightlife. The town is home to many popular attractions, including the Oceanarium, Bournemouth Pier, and the Russell-Cotes Art Gallery and Museum. Bournemouth is surrounded by stunning natural beauty, with the New Forest National Park to the east and the Jurassic Coast to the west. Visitors can enjoy a variety of outdoor activities, from hiking and cycling to surfing and paddleboarding.",
        region: "conurbation",
        nearbyTowns: ["Poole", "Christchurch", "Ferndown"],
        localNote: "As one of the busiest spots on our patch, Bournemouth is where we handle the highest volume of same-day callouts — from Sandbanks-bound visitors to daily commuters caught out on the A338.",
      },
    },
    {
      params: { city: "christchurch" },
      props: {
        title: "Christchurch",
        areas: "Christchurch, Burton, Highcliffe-on-Sea, Mudeford, Purewell, Somerford, Stanpit, Tuckton",
        about: "Christchurch is a charming town situated on the south coast of England, where the rivers Avon and Stour meet. It is known for its historic priory, quaint streets, and beautiful coastline. Visitors can explore the town's rich history by visiting the Red House Museum and Gardens or taking a stroll around the medieval ruins of Christchurch Castle. The town is also home to a bustling weekly market, held every Monday, where visitors can find a wide range of local produce and crafts. Christchurch is surrounded by stunning natural beauty, with the New Forest National Park and the Jurassic Coast within easy reach.",
        region: "conurbation",
        nearbyTowns: ["Bournemouth", "Ringwood", "Wimborne"],
        localNote: "Christchurch's spot on the edge of the New Forest means we regularly fit tyres to caravans and trailers heading off for a weekend away, alongside our everyday car and van work.",
      },
    },
    {
      params: { city: "dorchester" },
      props: {
        title: "Dorchester",
        areas: "Dorchester, Athelhampton, Bradford Peverell, Broadmayne, Buckland Newton, Charminster, Cheselbourne, Frampton, Godmanstone, Grimstone, Piddlehinton, Tincleton, Tolpuddle",
        about: "Dorchester is the county town of Dorset and is situated in the heart of the county. It is known for its rich history, with Roman ruins and a wealth of museums and historic buildings to explore. Visitors can explore the town's history by visiting the Dorset County Museum or taking a stroll around Maiden Castle, one of the largest Iron Age hillforts in Europe. The town is also home to a vibrant market, held on Wednesdays, where visitors can find everything from fresh produce to handmade crafts. Dorchester is surrounded by beautiful countryside, with the South Dorset Ridgeway and the Jurassic Coast within easy reach.",
        region: "coastal",
        nearbyTowns: ["Weymouth", "Wareham", "Poole"],
        localNote: "Dorchester's mix of town-centre traffic and the rural roads around Maiden Castle keeps our technicians busy with everything from nail punctures to full tyre replacements.",
      },
    },
    {
      params: { city: "ferndown" },
      props: {
        title: "Ferndown",
        areas: "Ferndown, Hampreston, Longham, Parley, Trickett's Cross",
        about: "Ferndown is a town located in East Dorset, surrounded by heathland and woodland. It is known for its proximity to the New Forest National Park and for being a popular retirement destination. Visitors can explore the nearby Moors Valley Country Park or take a leisurely stroll around the beautiful heathland of Ferndown Common. The town is also home to a number of shops and restaurants, making it a popular destination for both locals and visitors.",
        region: "conurbation",
        nearbyTowns: ["Wimborne", "Verwood", "Bournemouth"],
        localNote: "With the New Forest on the doorstep, Ferndown sees plenty of caravan and motorhome traffic through the warmer months — exactly the kind of fitting our mobile caravan tyre team specialises in.",
      },
    },
    {
      params: { city: "gillingham" },
      props: {
        title: "Gillingham",
        areas: "Gillingham, Bourton, East Stour, Fifehead Magdalen, Fifehead Neville, Marnhull, Motcombe, Stour Provost",
        about: "Gillingham is a market town located in the Blackmore Vale area of Dorset. It is known for its historic church, bustling market, and beautiful countryside. Visitors can explore the town's history by visiting St. Mary the Virgin Church or taking a stroll around the ruins of Gillingham Castle. The town is also home to a bustling weekly market, held on Tuesdays, where visitors can find a wide range of local produce and crafts. Gillingham is surrounded by stunning natural beauty, with the Cranborne Chase and West Wiltshire Downs Area of Outstanding Natural Beauty within easy reach.",
        region: "north",
        nearbyTowns: ["Shaftesbury", "Sturminster Newton", "Blandford Forum"],
        localNote: "Gillingham's farming community means we're regularly out on rural tracks around the Blackmore Vale, fitting tyres on everything from family cars to farm vehicles.",
      },
    },
    {
      params: { city: "poole" },
      props: {
        title: "Poole",
        areas: "Poole, Ashington, Branksome Park, Canford Cliffs, Ham Common, Hamworthy, Lilliput, Lower Parkstone, Newtown, Parkstone, Sandbanks, Talbot Village, Upper Parkstone, Whitecliff",
        about: "Poole is a coastal town located on the south coast of England. It is known for its beautiful beaches, historic quay, and busy port. Visitors can explore the town's rich maritime history by visiting the Poole Museum or taking a boat trip around Poole Harbour. The town is also home to a bustling quayside, where visitors can enjoy a wide range of restaurants, cafes, and shops. Poole is surrounded by stunning natural beauty, with the Jurassic Coast to the east and the Dorset AONB to the west.",
        region: "conurbation",
        nearbyTowns: ["Bournemouth", "Wimborne", "Wareham"],
        localNote: "Poole is home to our head office, so if you're local to the town you're never far from one of our fully-stocked vans.",
      },
    },
    {
      params: { city: "ringwood" },
      props: {
        title: "Ringwood",
        areas: "Ringwood, Avon Castle, Burley, Ellingham Harbridge and Ibsley, Poulner",
        about: "Ringwood is a historic market town located on the western edge of the New Forest National Park. It is known for its quaint streets, beautiful countryside, and proximity to the coast. Visitors can explore the town's history by visiting the Ringwood Meeting House and Museum or taking a stroll around the Ringwood Town Trail. The town is also a popular destination for outdoor enthusiasts, with easy access to the New Forest National Park and the Jurassic Coast.",
        region: "conurbation",
        nearbyTowns: ["Verwood", "Christchurch", "Ferndown"],
        localNote: "Sitting right on the edge of the New Forest, Ringwood is another spot where we see a lot of caravan and trailer tyre work alongside our usual car and van callouts.",
      },
    },
    {
      params: { city: "shaftesbury" },
      props: {
        title: "Shaftesbury",
        areas: "Shaftesbury, Donhead St. Mary, Donhead St. Andrew, Enmore Green, Fontmell Magna, Margaret Marsh, Melbury Abbas, Melbury Sampford, Stour Row, West Melbury",
        about: "Shaftesbury is a charming town located on a hilltop in north Dorset. It is known for its picturesque streets, historic abbey ruins, and stunning views of the surrounding countryside. Visitors can explore the town's history by visiting the ruins of Shaftesbury Abbey or taking a stroll around Gold Hill, made famous in the iconic Hovis advert. The town is also home to a bustling weekly market, held on Thursdays, where visitors can find everything from fresh produce to handmade crafts.",
        region: "north",
        nearbyTowns: ["Gillingham", "Sturminster Newton", "Blandford Forum"],
        localNote: "Our depot here in Shaftesbury means technicians are based right in the town, so North Dorset customers get the same fast response as anywhere closer to Poole.",
      },
    },
    {
      params: { city: "sturminster-newton" },
      props: {
        title: "Sturminster Newton",
        areas: "Sturminster Newton, Caundle Marsh, Child Okeford, Fiddleford, Hinton St Mary, Shillingstone, Stalbridge, Stock Gaylard, Todber",
        about: "Sturminster Newton is a market town located in the heart of Dorset. It is known for its beautiful countryside, historic church, and bustling market. Visitors can explore the town's history by visiting Sturminster Newton Mill or taking a stroll around the Sturminster Newton Town Trail. The town is also home to a popular weekly market, held on Mondays, where visitors can find a wide range of local produce and crafts.",
        region: "north",
        nearbyTowns: ["Blandford Forum", "Gillingham", "Shaftesbury"],
        localNote: "Like much of the Blackmore Vale, the roads around Sturminster Newton are rural and can be hard on tyres — we regularly help drivers who've picked up a puncture on unlit country lanes.",
      },
    },
    {
      params: { city: "swanage" },
      props: {
        title: "Swanage",
        areas: "Swanage, Acton, Langton Matravers, Studland, Worth Matravers",
        about: "Swanage is a coastal town located on the eastern edge of the Isle of Purbeck. It is known for its beautiful beaches, historic pier, and stunning coastal walks. Visitors can explore the town's history by taking a stroll around the Swanage Town Trail or visiting the Swanage Museum and Heritage Centre. The town is also a popular destination for outdoor enthusiasts, with easy access to the Jurassic Coast and the Purbeck Hills.",
        region: "coastal",
        nearbyTowns: ["Wareham", "Poole", "Dorchester"],
        localNote: "Swanage's coastal roads and the steep hills around the Purbeck Hills put extra strain on tyres, so we see a good mix of routine replacements and emergency callouts out this way.",
      },
    },
    {
      params: { city: "verwood" },
      props: {
        title: "Verwood",
        areas: "Verwood, Alderholt, Cranborne, Horton, Woodlands",
        about: "Verwood is a town located in East Dorset, surrounded by heathland and woodland. It is known for its proximity to the New Forest National Park and for being a popular retirement destination. Visitors can explore the nearby Moors Valley Country Park or take a leisurely stroll around the beautiful heathland of Verwood Common. The town is also home to a number of shops and restaurants, making it a popular destination for both locals and visitors.",
        region: "conurbation",
        nearbyTowns: ["Ferndown", "Ringwood", "Wimborne"],
        localNote: "Verwood's mix of quiet residential streets and surrounding heathland means most of our work here is straightforward home and driveway fitting.",
      },
    },
    {
      params: { city: "wareham" },
      props: {
        title: "Wareham",
        areas: "Wareham, Arne, Bloxworth, Corfe Castle, Creech, East Holme, East Stoke, Holmebridge, Lulworth, Lytchett Matravers, Lytchett Minster, Organford, Ridge, Sandford, Stoborough Green, West Holme, Winfrith Newburgh",
        about: "Wareham is a historic market town located on the River Frome in the Purbeck district of Dorset. It is known for its beautiful countryside, historic castle ruins, and bustling weekly market. Visitors can explore the town's history by visiting Wareham Town Museum or taking a stroll around the Wareham Town Walls. The town is also a popular destination for outdoor enthusiasts, with easy access to the Jurassic Coast and the Purbeck Hills.",
        region: "coastal",
        nearbyTowns: ["Poole", "Swanage", "Dorchester"],
        localNote: "Wareham's position on the edge of the Purbeck Hills means we often combine tyre fitting with our puncture repair service for drivers who've picked up damage on the more rural routes nearby.",
      },
    },
    {
      params: { city: "weymouth" },
      props: {
        title: "Weymouth",
        areas: "Weymouth, Lanehouse, Nottington, Preston, Radipole, Sutton Poyntz, Westham",
        about: "Weymouth is a popular coastal town located on the south coast of England. It is known for its beautiful beaches, historic harbour, and lively seafront. Visitors can explore the town's history by visiting the Nothe Fort or taking a stroll around the Weymouth Town Trail. The town is also a popular destination for families, with a wide range of attractions, including the SEA LIFE Weymouth and the Weymouth Pavilion.",
        region: "coastal",
        nearbyTowns: ["Dorchester", "Wareham", "Swanage"],
        localNote: "As a seaside town, Weymouth sees a lot of visiting traffic in summer, and we build extra capacity into our schedule so holidaymakers aren't left stranded with a flat tyre.",
      },
    },
    {
      params: { city: "wimborne" },
      props: {
        title: "Wimborne",
        areas: "Wimborne, Canford Bottom, Colehill, Corfe Mullen, Cowgrove, Furzehill, Gaunts Common, Hinton Martell, Holt, Horton Heath, Knobcrook, Merley, Stapehill, Witchampton",
        about: "Wimborne is a historic market town located in East Dorset. It is known for its picturesque streets, historic Minster, and bustling weekly market. Visitors can explore the town's history by visiting the Wimborne Minster or taking a stroll around the Wimborne Town Trail. The town is also home to a bustling weekly market, held on Fridays and Saturdays, where visitors can find a wide range of local produce and crafts. Wimborne is surrounded by beautiful countryside, with easy access to the Cranborne Chase and West Wiltshire Downs Area of Outstanding Natural Beauty.",
        region: "conurbation",
        nearbyTowns: ["Ferndown", "Poole", "Blandford Forum"],
        localNote: "Wimborne's twice-weekly market brings extra traffic into town, so we keep flexible slots free for drivers who pick up a puncture while out and about.",
      },
    },
  ];

  return cities;
}

const { title, about, region, nearbyTowns, localNote } = Astro.props as CityProps;

const regionIntro: Record<Region, string> = {
  north: `As demand for mobile tyre fitting has grown across North Dorset, we opened a dedicated depot in Shaftesbury to keep response times in ${title} and the surrounding Blackmore Vale just as fast as anywhere else we cover. Whether you're stranded on a farm track or need tyres fitted on the drive, our technicians carry the same fully-stocked vans as the rest of our fleet.`,
  conurbation: `${title} sits right in the heart of our home patch — our head office and main depot are just up the road in Poole, so it's one of the quickest areas for us to reach. Our technicians are in and around ${title} every day, fitting tyres at homes, workplaces and roadside breakdowns across the area.`,
  coastal: `${title} is one of the further-flung corners of our coverage area, but that doesn't mean you'll wait any longer for a fully-stocked van to reach you. Our technicians regularly make the trip out to ${title} and the surrounding area, from routine tyre changes to emergency roadside callouts.`,
};

const description = `Need a mobile tyre fitting service in ${title}? Our technicians come to your home, work or the roadside and can usually fit your tyres the same day. Call us for a quote.`;
---

<MainLayout
  title={`Mobile Tyre Fitting in ${title}`}
  description={description}
  heroHeading={`Mobile Tyre Fitting in ${title}`}
  heroSubheading="We Come To You At Home, Work Or Roadside"
  heroImage={heroImages["mobile-tyre-fitting"]}
  heroImageAlt={`A Freeway Mobile Tyres technician fitting a tyre for a customer in ${title}`}
  mainHeading={`Mobile Tyre Fitting in ${title}`}
  service={{ name: `Mobile Tyre Fitting in ${title}`, description }}
>
  <p>{regionIntro[region]}</p>
  <p>
    Our fitters can work on <strong>cars, vans, caravans, motorhomes and trailers</strong>, and every quote includes wheel balancing, valve replacement and casing disposal — no hidden extras. If you're in {title} and ready to book, call us on <strong>0800 7311 260</strong> and we'll get a technician on the way.
  </p>

  <section class="local-note">
    <h3>Local to {title}</h3>
    <p>{localNote}</p>
  </section>

  <section id="about" class="about-town">
    <h3>About {title}</h3>
    <p>{about}</p>
  </section>

  <h2>Why Choose Freeway Mobile Tyres</h2>
  <p>
    Across {title} and neighbouring {nearbyTowns.join(", ")}, we're dedicated to providing top-quality mobile tyre fitting seven days a week, with same-day fitting as standard. We pride ourselves on being one of the fastest mobile tyre services in Dorset, with an <em>average arrival time of just 60 minutes</em>.
  </p>

  <h2>Other Services We Offer in {title}</h2>
  <p>
    Alongside mobile tyre fitting, we offer <a class="link-danger" href="/mobile-tyres/puncture-repair">puncture repairs</a>, <a class="link-danger" href="/services/locking-wheel-nut-removal">locking wheel nut removal</a>, <a class="link-danger" href="/services/mobile-car-battery-replacement">battery replacement</a> and <a class="link-danger" href="/services/tyre-pressure-monitoring-system">TPMS</a> to drivers in {title} and nearby {nearbyTowns[0]} and {nearbyTowns[1]}.
  </p>

  <h2>Get A Quote For Tyres In {title}</h2>
  <p>
    Ready to book, or just need a price? Call our free phone number <strong>0800 7311 260</strong> and our team will get back to you with a quote for your {title} address.
  </p>
</MainLayout>

<style>
  .local-note,
  .about-town {
    padding: var(--space-5) var(--space-6);
    margin-block: var(--space-6);
    border-radius: var(--radius-lg);
  }

  .local-note {
    background: var(--color-red-50);
    border-left: 4px solid var(--color-red-500);
  }

  .about-town {
    background: var(--color-surface);
  }

  .local-note h3,
  .about-town h3 {
    margin-bottom: var(--space-2);
  }

  .local-note p,
  .about-town p {
    margin-bottom: 0;
  }
</style>
