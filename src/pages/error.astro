---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusPanel from "../components/StatusPanel.astro";
---

<BaseLayout title="Error" description="An error has occurred.">
  <StatusPanel icon="x" heading="Error" tone="error">
    <p>An error has occurred.</p>
    <a href="/" class="btn btn-dark">Return to the homepage</a>
  </StatusPanel>
</BaseLayout>
