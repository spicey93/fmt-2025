---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const reasons = [
  "Free same-day fitting",
  "Open 7 days a week",
  "Average arrival under 60 minutes",
  "Balancing, valves & disposal included",
  "Cars, vans, caravans & trailers",
];
---

<aside class="aside">
  <div class="aside-call">
    <p class="aside-call-label">Speak to our team</p>
    <a class="aside-call-number" href={site.phoneHref}>
      <Icon name="telephone" />
      {site.phone}
    </a>
    <p class="aside-call-note">Freephone &middot; Open 7 days a week</p>
    <a class="btn btn-light btn-block" href="#quoteForm">Request a quote online</a>
  </div>

  <div class="aside-card">
    <h3>Why drivers choose us</h3>
    <ul>
      {
        reasons.map((reason) => (
          <li>
            <Icon name="check" />
            {reason}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="aside-card aside-rating">
    <Icon name="google" class="aside-rating-logo" />
    <div>
      <p class="aside-rating-score">
        <strong>{site.rating}</strong>
        <span class="stars" role="img" aria-label={`${site.rating} out of 5 stars`}>
          <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
        </span>
      </p>
      <p class="aside-rating-count">From {site.reviewCount} Google reviews</p>
    </div>
  </div>
</aside>

<style>
  .aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 992px) {
    .aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }

  .aside-call {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.18), transparent 55%),
      var(--color-red-500);
    color: var(--color-white);
  }

  .aside-call-label {
    margin: 0 0 var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  .aside-call-number {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  .aside-call-number :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .aside-call-note {
    margin: var(--space-1) 0 var(--space-5);
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.85);
  }

  .aside-card {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }

  .aside-card h3 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-4);
  }

  .aside-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-ink-700);
  }

  .aside-card li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .aside-card li :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    padding: 3px;
    margin-top: 0.1rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-red-50);
    color: var(--color-accent);
    stroke-width: 3;
  }

  .aside-rating {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .aside-rating :global(.aside-rating-logo) {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
  }

  .aside-rating p {
    margin: 0;
  }

  .aside-rating-score {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .aside-rating-score strong {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 800;
  }

  .aside-rating-count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
