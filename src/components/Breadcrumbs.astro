---
import { navGroups } from "../data/nav";

interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;

const staticLabels: Record<string, string> = {
  about: "About",
  contact: "Contact",
  "cookie-policy": "Cookie Policy",
  "privacy-policy": "Privacy Policy",
  "terms-and-conditions": "Terms & Conditions",
  "site-map": "Site Map",
  thanks: "Thank You",
};

const path = Astro.url.pathname.replace(/^\/|\/$/g, "");
const segments = path.length ? path.split("/") : [];

interface Crumb {
  label: string;
  href: string;
}

const crumbs: Crumb[] = [{ label: "Home", href: "/" }];

if (segments.length) {
  const [first, second] = segments;
  const group = navGroups.find((g) => g.slug === first);

  // Group slugs (/mobile-tyres, /services, /coverage) have no index page, so they're skipped
  if (group) {
    const sub = group.subPages.find((p) => p.slug === second);
    if (sub) crumbs.push({ label: sub.title, href: `/${first}/${second}` });
  } else {
    crumbs.push({ label: staticLabels[first] ?? first, href: `/${first}` });
  }
}

const showBreadcrumbs = crumbs.length > 1;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.label,
    item: new URL(crumb.href, Astro.site).href,
  })),
};
---

{
  showBreadcrumbs && (
    <nav class:list={["breadcrumbs", `breadcrumbs--${variant}`]} aria-label="Breadcrumb">
      <ol>
        {crumbs.map((crumb, index) => (
          <li>
            {index === crumbs.length - 1 ? (
              <span aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href}>{crumb.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
{showBreadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

<style>
  .breadcrumbs {
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: "";
    width: 5px;
    height: 5px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.6;
  }

  .breadcrumbs a {
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .breadcrumbs [aria-current="page"] {
    font-weight: 600;
  }

  .breadcrumbs--dark {
    color: var(--color-ink-400);
  }

  .breadcrumbs--dark a:hover,
  .breadcrumbs--dark [aria-current="page"] {
    color: var(--color-white);
  }

  .breadcrumbs--light {
    color: var(--color-ink-500);
  }

  .breadcrumbs--light a:hover,
  .breadcrumbs--light [aria-current="page"] {
    color: var(--color-ink-950);
  }
</style>
