---
// Inline SVG icon set. Stroke icons inherit currentColor; filled icons are listed in `filled`.
const icons = {
  calendar:
    '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17M8 3v3.5M16 3v3.5"/>',
  "calendar-check":
    '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17M8 3v3.5M16 3v3.5M8.5 14.5l2 2 4.5-4.5"/>',
  car: '<path d="M4 16.5V12l2-5a2 2 0 011.9-1.3h8.2A2 2 0 0118 7l2 5v4.5M4 16.5h16M5 11h14"/><circle cx="7.5" cy="16.5" r="1.75"/><circle cx="16.5" cy="16.5" r="1.75"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  crosshair:
    '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M12 1.5V5M12 19v3.5M1.5 12H5M19 12h3.5"/>',
  envelope: '<rect x="3" y="5.5" width="18" height="13" rx="2.2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  house: '<path d="M4 11.5L12 4l8 7.5M6 10v9.5a1 1 0 001 1h10a1 1 0 001-1V10M10 20.5V15h4v5.5"/>',
  map: '<path d="M12 21s-6.5-5.7-6.5-11A6.5 6.5 0 0112 3.5a6.5 6.5 0 016.5 6.5c0 5.3-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.25"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  "check-circle": '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  bolt: '<path d="M13 2.5L4.5 13.5H11l-1 8 8.5-11H12z"/>',
  wrench:
    '<path d="M14.7 6.3a4 4 0 00-5.4 5.4L3.5 17.5a1.8 1.8 0 002.6 2.6l5.8-5.8a4 4 0 005.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>',
  tyre: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v5M12 16v5M3 12h5M16 12h5"/>',
  battery:
    '<rect x="3" y="7" width="18" height="12" rx="2"/><path d="M7 7V5h3v2M14 7V5h3v2M7 13h3M15.5 11.5v3M14 13h3"/>',
  gauge: '<path d="M4.5 17a8.5 8.5 0 1115 0"/><path d="M12 13l3.5-4"/><circle cx="12" cy="13" r="1.2"/>',
  disc: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 5.5v2M18.5 12h-2M12 18.5v-2M5.5 12h2"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3M12 14.5v2"/>',
  caravan:
    '<path d="M3 17V8a3 3 0 013-3h10a4 4 0 014 4v8M3 17h15M20 17h2"/><circle cx="9" cy="17.5" r="1.75"/><rect x="6" y="8" width="5" height="4" rx="1"/><path d="M14 8h3v4h-3z"/>',
  wheel: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="1.5"/><path d="M12 6v4.5M17.7 10.1l-4.3 1.4M15.5 16.9l-2.6-3.7M8.5 16.9l2.6-3.7M6.3 10.1l4.3 1.4"/>',
  "arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "chevron-right": '<path d="M9 5l7 7-7 7"/>',
  "chevron-down": '<path d="M5 9l7 7 7-7"/>',
  x: '<path d="M6 6l12 12M18 6L6 18"/>',
  route: '<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H16a3 3 0 000-6H8a3 3 0 010-6h7.5"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.3L7 21l5-2.5 5 2.5-1.5-7.7"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M16 4.6a3.5 3.5 0 010 6.8M18 14a6.5 6.5 0 013.5 6"/>',
  phone:
    '<path d="M6.6 2.9c.6-.2 1.3 0 1.7.5l2 2.6c.4.5.4 1.2 0 1.7L8.8 9.3c1 2.2 2.7 3.9 4.9 4.9l1.6-1.5c.5-.4 1.2-.4 1.7 0l2.6 2c.5.4.7 1.1.5 1.7l-.7 2.1c-.3.8-1 1.3-1.9 1.2-7.6-.9-13.5-6.8-14.4-14.4-.1-.9.4-1.6 1.2-1.9z"/>',
};

const filled = {
  star: '<path d="M12 2.5l2.9 6.1 6.6.7-4.9 4.6 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.7z"/>',
  telephone: icons.phone,
  facebook:
    '<path d="M13.5 21.5v-8.2h2.8l.4-3.2h-3.2V8c0-.9.3-1.6 1.6-1.6h1.7V3.5C16.5 3.5 15.4 3.4 14.2 3.4c-2.6 0-4.4 1.6-4.4 4.5v2.6H7v3.2h2.8v8.2z"/>',
  youtube:
    '<path fill-rule="evenodd" d="M5.5 5.5h13A3.5 3.5 0 0122 9v6a3.5 3.5 0 01-3.5 3.5h-13A3.5 3.5 0 012 15V9a3.5 3.5 0 013.5-3.5zm5 3.8v5.4l5-2.7z"/>',
};

// Multi-colour brand marks
const brand = {
  google:
    '<path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 01-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0012 22z"/><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 002 12c0 1.6.4 3.1 1.1 4.6z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 003.1 7.4L6.4 10C7.2 7.7 9.4 6 12 6z"/>',
  yelp: '<circle cx="12" cy="12" r="10" fill="#ffd200"/><text x="12" y="16.3" text-anchor="middle" font-size="11" font-weight="800" font-family="Arial, sans-serif" fill="#1a1a1a">Y</text>',
};

export type IconName = keyof typeof icons | keyof typeof filled | keyof typeof brand;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const kind = name in brand ? "brand" : name in filled ? "filled" : "stroke";
const body =
  (brand as Record<string, string>)[name] ??
  (filled as Record<string, string>)[name] ??
  (icons as Record<string, string>)[name];
---

{
  kind === "stroke" ? (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
      set:html={body}
    />
  ) : kind === "filled" ? (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true" set:html={body} />
  ) : (
    <svg viewBox="0 0 24 24" class={className} aria-hidden="true" set:html={body} />
  )
}
