---
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  heading: string;
  tone?: "success" | "error";
}

const { icon, heading, tone = "success" } = Astro.props;
---

<section class="status">
  <div class="container">
    <div class="status-card">
      <span class:list={["status-icon", `status-icon--${tone}`]}><Icon name={icon} /></span>
      <h1>{heading}</h1>
      <slot />
    </div>
  </div>
</section>

<style>
  .status {
    padding-block: var(--space-9);
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, var(--color-red-50), transparent 70%),
      var(--color-bg);
  }

  .status-card {
    max-width: 620px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .status-icon {
    display: inline-grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: var(--space-5);
    border-radius: 50%;
  }

  .status-icon--success {
    background: #e6f6ec;
    color: var(--color-success);
  }

  .status-icon--error {
    background: var(--color-red-50);
    color: var(--color-accent);
  }

  .status-icon :global(svg) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .status-card h1 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-4);
  }

  .status-card :global(p) {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .status-card :global(.btn) {
    margin-top: var(--space-4);
  }
</style>
