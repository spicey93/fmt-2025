---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Quote from "./Quote.astro";
import Icon from "./Icon.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { site } from "../data/site";

interface Props {
  heroHeading: string;
  heroSubheading: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
}

const { heroHeading, heroSubheading, heroImage, heroImageAlt } = Astro.props;
const years = new Date().getFullYear() - site.established;
---

<section class="hero">
  <div class="hero-media">
    <Image
      src={heroImage}
      alt={heroImageAlt}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <Breadcrumbs variant="dark" />
      <p class="hero-pill">
        <span class="hero-pill-dot" aria-hidden="true"></span>
        Dorset’s mobile tyre specialists since {site.established}
      </p>
      <h1>{heroHeading}</h1>
      <p class="hero-subheading">{heroSubheading}</p>

      <div class="hero-ctas">
        <a href={site.phoneHref} class="btn btn-primary btn-lg">
          <Icon name="telephone" /> {site.phone}
        </a>
        <a href="#quoteForm" class="btn btn-outline btn-lg hero-quote-link">
          Get a free quote <Icon name="arrow-right" />
        </a>
      </div>

      <ul class="hero-points">
        <li><Icon name="check" /> Open 7 days a week</li>
        <li><Icon name="check" /> Same-day fitting</li>
        <li><Icon name="check" /> We come to you</li>
      </ul>

      <div class="hero-proof">
        <div class="hero-rating">
          <Icon name="google" class="hero-rating-logo" />
          <div>
            <p class="hero-rating-score">
              <strong>{site.rating}</strong>
              <span class="stars" aria-label={`${site.rating} out of 5 stars`}>
                <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
              </span>
            </p>
            <p class="hero-rating-count">{site.reviewCount} Google reviews</p>
          </div>
        </div>
        <div class="hero-stat">
          <strong>{years}</strong>
          <span>years on the road<br />across Dorset</span>
        </div>
      </div>
    </div>

    <!-- Inline on desktop; on mobile it becomes a modal opened by any "#quoteForm" link (see quoteModal.js) -->
    <div class="hero-form quote-modal" data-quote-modal>
      <div class="quote-modal-backdrop" data-quote-close></div>
      <div class="quote-modal-panel" data-quote-panel>
        <button class="quote-modal-close" type="button" data-quote-close aria-label="Close quote form">
          <Icon name="x" />
        </button>
        <Quote />
      </div>
    </div>
  </div>
</section>

<script src="/src/scripts/quoteModal.js"></script>

<style>
  /* No stacking context here, so the mobile quote modal can sit above the sticky header */
  .hero {
    position: relative;
    background: var(--color-ink-950);
    color: var(--color-white);
    padding-block: var(--space-6) var(--space-8);
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .hero {
      padding-block: var(--space-7) var(--space-9);
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.55;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 85% 110%, rgba(208, 31, 39, 0.45), transparent 70%),
      linear-gradient(95deg, rgba(11, 13, 16, 0.97) 0%, rgba(11, 13, 16, 0.88) 45%, rgba(11, 13, 16, 0.55) 100%);
  }

  /* Road-marking stripe along the bottom edge */
  .hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-red-500) 0 48px,
      transparent 48px 72px
    );
    opacity: 0.9;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-8);
    }
  }

  .hero-copy :global(.breadcrumbs) {
    margin-bottom: var(--space-5);
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink-200);
  }

  .hero-pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(61, 220, 132, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pill-dot {
      animation: none;
    }
  }

  .hero-copy h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
    max-width: 14ch;
  }

  .hero-subheading {
    font-size: var(--font-size-xl);
    line-height: 1.45;
    color: var(--color-ink-300);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  @media (max-width: 479px) {
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 992px) {
    .hero-quote-link {
      display: none;
    }
  }

  /* Quote modal (mobile only, and only once JS is available to open it) */
  .quote-modal-backdrop,
  .quote-modal-close {
    display: none;
  }

  @media (max-width: 991px) {
    :global(.js) .hero-form.quote-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      max-width: none;
      padding: var(--space-4);
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      /* Hide only after the fade-out finishes... */
      transition: opacity var(--duration-base) var(--ease-out), visibility 0s linear var(--duration-base);
    }

    :global(.js) .hero-form.quote-modal:global(.is-open) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      /* ...but become visible (and focusable) immediately on open */
      transition: opacity var(--duration-base) var(--ease-out), visibility 0s;
    }

    :global(.js) .quote-modal-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(11, 13, 16, 0.78);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    :global(.js) .quote-modal-panel {
      position: relative;
      width: 100%;
      max-width: 460px;
      margin: auto;
      transform: translateY(24px) scale(0.98);
      transition: transform var(--duration-base) var(--ease-out);
    }

    /* The panel receives focus on open, but only as a container — no focus ring needed */
    :global(.js) .quote-modal-panel:focus {
      outline: none;
    }

    :global(.js) .quote-modal:global(.is-open) .quote-modal-panel {
      transform: none;
    }

    :global(.js) .quote-modal-close {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      margin: 0 0 var(--space-3) auto;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--color-white);
      color: var(--color-ink-950);
      cursor: pointer;
      box-shadow: var(--shadow-md);
    }

    .quote-modal-close :global(svg) {
      width: 1.25rem;
      height: 1.25rem;
      stroke-width: 2.4;
    }
  }

  @media (max-width: 991px) and (prefers-reduced-motion: reduce) {
    :global(.js) .quote-modal,
    :global(.js) .quote-modal-panel {
      transition: none;
    }
  }

  .hero-points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    padding: 0;
    margin-bottom: var(--space-6);
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: var(--color-ink-100);
  }

  .hero-points li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero-points :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    padding: 3px;
    border-radius: 50%;
    background: var(--color-red-500);
    color: var(--color-white);
    stroke-width: 3;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-rating {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-rating :global(.hero-rating-logo) {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.55rem;
    border-radius: 50%;
    background: var(--color-white);
    flex-shrink: 0;
  }

  .hero-rating p {
    margin: 0;
  }

  .hero-rating-score {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    line-height: 1.2;
  }

  .hero-rating-score strong {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 800;
  }

  .hero-rating-count {
    font-size: var(--font-size-xs);
    color: var(--color-ink-300);
  }

  .hero-stat {
    display: none;
    align-items: center;
    gap: var(--space-3);
    padding-left: var(--space-5);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 480px) {
    .hero-stat {
      display: flex;
    }
  }

  .hero-stat strong {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-white);
  }

  .hero-stat span {
    font-size: var(--font-size-xs);
    line-height: 1.35;
    color: var(--color-ink-300);
  }

  .hero-form {
    width: 100%;
    max-width: 460px;
    justify-self: center;
  }

  @media (min-width: 992px) {
    .hero-form {
      justify-self: end;
    }
  }

  /* Centre the hero copy on mobile and tablet, where it stacks above (or without) the form */
  @media (max-width: 991px) {
    .hero-copy {
      text-align: center;
    }

    .hero-copy h1,
    .hero-subheading {
      margin-inline: auto;
    }

    .hero-copy :global(.breadcrumbs ol),
    .hero-ctas,
    .hero-points,
    .hero-proof {
      justify-content: center;
    }

    .hero-rating {
      text-align: left;
    }
  }
</style>
