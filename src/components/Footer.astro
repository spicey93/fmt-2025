---
import { tyreDropdown, servicesDropdown, coverageDropdown } from "../data/nav";
import { site } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" aria-label="Freeway Mobile Tyres home">
          <img
            src="/img/logos/white-logo-no-background.webp"
            alt="Freeway Mobile Tyres"
            width="200"
            height="52"
            loading="lazy"
          />
        </a>
        <p class="footer-tagline">
          Dorset's mobile tyre fitting specialists since {site.established}. We come to you — at home, at work or at
          the roadside.
        </p>
        <a class="footer-phone" href={site.phoneHref}>
          <span class="footer-phone-icon"><Icon name="telephone" /></span>
          <span>
            <span class="footer-phone-label">Freephone, 7 days a week</span>
            <span class="footer-phone-number">{site.phone}</span>
          </span>
        </a>
        <div class="footer-social">
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <Icon name="facebook" />
          </a>
          <a href={site.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <Icon name="youtube" />
          </a>
        </div>
      </div>

      <nav class="footer-col" aria-label={tyreDropdown.title}>
        <p class="footer-heading">{tyreDropdown.title}</p>
        <ul>
          {tyreDropdown.subPages.map((page) => (
            <li><a href={`/${tyreDropdown.slug}/${page.slug}`}>{page.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label={servicesDropdown.title}>
        <p class="footer-heading">{servicesDropdown.title}</p>
        <ul>
          {servicesDropdown.subPages.map((page) => (
            <li><a href={`/${servicesDropdown.slug}/${page.slug}`}>{page.title}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-heading">Contact</p>
        <ul class="footer-contact">
          <li>
            <Icon name="envelope" />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="map" />
            <span>{site.address}</span>
          </li>
          <li>
            <Icon name="house" />
            <a href="/about">About us</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-areas">
      <p class="footer-heading">Areas we cover</p>
      <ul>
        {coverageDropdown.subPages.map((page) => (
          <li><a href={`/${coverageDropdown.slug}/${page.slug}`}>{page.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Freeway Mobile Tyres. All rights reserved.</p>
      <ul class="footer-legal">
        <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
        <li><a href="/cookie-policy">Cookie Policy</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/site-map">Site Map</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink-950);
    color: var(--color-ink-300);
    padding-top: var(--space-9);
    font-size: var(--font-size-sm);
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .site-footer a:hover {
    color: var(--color-white);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-bottom: var(--space-7);
  }

  @media (min-width: 700px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1080px) {
    .footer-top {
      grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    }
  }

  .footer-brand img {
    height: 40px;
    width: auto;
  }

  .footer-tagline {
    margin: var(--space-4) 0 var(--space-5);
    max-width: 22rem;
    line-height: 1.6;
  }

  .footer-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-phone-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-red-500);
    color: var(--color-white);
  }

  .footer-phone-icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .footer-phone-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-ink-400);
  }

  .footer-phone-number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.2;
  }

  .footer-social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .footer-social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-ink-800);
    color: var(--color-ink-200);
    transition: background-color var(--duration-fast), color var(--duration-fast);
  }

  .footer-social a:hover {
    background: var(--color-red-500);
  }

  .footer-social :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .footer-heading {
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-white);
  }

  .footer-col ul,
  .footer-areas ul,
  .footer-legal {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-3);
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    word-break: break-word;
  }

  .footer-contact :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
    color: var(--color-red-400);
  }

  .footer-areas {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-ink-800);
  }

  .footer-areas ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-ink-800);
    font-size: var(--font-size-xs);
    color: var(--color-ink-400);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
</style>
